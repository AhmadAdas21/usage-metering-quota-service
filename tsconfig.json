{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
"moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["models/**/*.ts", "database/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}